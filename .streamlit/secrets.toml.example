# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud, paste these into App settings -> Secrets instead.
GEMINI_API_KEY = "your-key-from-aistudio.google.com"
GEMINI_MODEL = "gemini-3.8-flash"
ADMIN_MODE = "false"   # set "true" only for your own demo deployment
AI_LIMIT = "40"        # AI answers per learner session; after that the tutor quotes the reading

# Optional: also save the log to a Google Sheet, because Streamlit Cloud wipes logs.csv on restart.
# Share the sheet with the service account's client_email as an Editor.
LOG_SHEET_URL = "https://docs.google.com/spreadsheets/d/your-sheet-id"

# Keep this table last: every key after it belongs to it. Paste the fields of the service
# account's JSON key file (Google Cloud -> IAM -> Service accounts -> Keys -> Add key -> JSON).
[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "hintfirst-logs@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
